// ============================================
// FUNGSI UTAMA: Generate MasterDoc
// ============================================
function seedMasterDoc() {
  const year = SEED_YEAR;
  const sheet = getSheet(CONFIG.SHEET_NAMES.MASTER_DOC);
  
  const newHeaders = ['docID', 'tahun', 'subsatker', 'kategori', 'nama_dokumen', 'bobot', 'aktif', 'parent_id', 'urutan'];
  
  sheet.clear();
  sheet.getRange(1, 1, 1, newHeaders.length).setValues([newHeaders]);
  
  let counter = 0;
  const newRows = [];
  
  for (const [fakultas, subsatkers] of Object.entries(DAFTAR_SUBSATKER)) {
    for (const subsatker of subsatkers) {
      const hasRTL = PRODI_DENGAN_RTL.indexOf(subsatker) !== -1;
      const struktur = getStrukturFor(subsatker);
      
      // Dokumen utama
      struktur.forEach(doc => {
        counter++;
        const parentID = 'D' + String(counter).padStart(5, '0');
        
        newRows.push([
          parentID, year, subsatker, 'A', doc.nama, 70, 'TRUE', '', doc.no
        ]);
        
        // Sub-item
        if (doc.subs && doc.subs.length > 0) {
          doc.subs.forEach((subName, idx) => {
            counter++;
            const subID = 'D' + String(counter).padStart(5, '0');
            newRows.push([
              subID, year, subsatker, 'A', subName, 70, 'TRUE', parentID, idx + 1
            ]);
          });
        }
      });
      
      // Kalau punya RTL
      if (hasRTL) {
        counter++;
        const rtlID = 'D' + String(counter).padStart(5, '0');
        newRows.push([
          rtlID, year, subsatker, 'B', DOKUMEN_RTL, 30, 'TRUE', '', 99
        ]);
      }
    }
  }
  
  if (newRows.length > 0) {
    sheet.getRange(2, 1, newRows.length, newHeaders.length).setValues(newRows);
  }
  
  Logger.log('✅ Berhasil generate ' + newRows.length + ' baris MasterDoc untuk tahun ' + year);
  Logger.log('Prodi dengan RTL: ' + PRODI_DENGAN_RTL.join(', '));
  Logger.log('Total subsatker: ' + Object.values(DAFTAR_SUBSATKER).flat().length);
}